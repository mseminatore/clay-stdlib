// clay-collections -- Data structures for Clay: Set, Stack, Queue, Range
//
// Usage:
//   import("clay-collections")
//
//   s = Set new()
//   s add(1)
//   s add(2)
//   s contains(1)   // true
//
//   stack = Stack new()
//   stack push(42)
//   stack pop        // 42
//
//   q = Queue new()
//   q enqueue("a")
//   q dequeue        // "a"
//
//   Range new(1, 5) each({ |i| i println() })

// --- Set: unique elements backed by Dict ---
Set = Object clone {
    _data = nil

    new() {
        s = self clone
        s _data = Dict clone
        s
    }

    from(arr) {
        s = self new()
        arr each({ |v| s add(v) })
        s
    }

    add(val) {
        _data set(val toString(), val)
        self
    }

    remove(val) {
        _data remove(val toString())
        self
    }

    contains(val) {
        _data has(val toString())
    }

    size() {
        _data size
    }

    toArray() {
        _data values
    }

    each(block) {
        self toArray() each(block)
        self
    }

    union(other) {
        result = self new()
        self toArray() each({ |v| result add(v) })
        other toArray() each({ |v| result add(v) })
        result
    }

    intersection(other) {
        result = self new()
        self toArray() filter({ |v| other contains(v) }) each({ |v| result add(v) })
        result
    }

    difference(other) {
        result = self new()
        self toArray() filter({ |v| other contains(v) not }) each({ |v| result add(v) })
        result
    }

    toString() {
        items = self toArray()
        "Set{" + items join(", ") + "}"
    }
}

// --- Stack: LIFO backed by Array ---
Stack = Object clone {
    _items = nil

    new() {
        s = self clone
        s _items = []
        s
    }

    push(val) {
        _items append(val)
        self
    }

    pop() {
        sz = _items size
        (sz == 0) ifTrue({ raise("Stack is empty") })
        val = _items at(sz - 1)
        _items removeAt(sz - 1)
        val
    }

    peek() {
        sz = _items size
        (sz == 0) ifTrue({ raise("Stack is empty") })
        _items at(sz - 1)
    }

    isEmpty() {
        _items size == 0
    }

    size() {
        _items size
    }

    toArray() {
        _items
    }

    toString() {
        "Stack" + _items toString()
    }
}

// --- Queue: FIFO backed by Array ---
Queue = Object clone {
    _items = nil

    new() {
        q = self clone
        q _items = []
        q
    }

    enqueue(val) {
        _items append(val)
        self
    }

    dequeue() {
        (_items size == 0) ifTrue({ raise("Queue is empty") })
        val = _items at(0)
        _items removeAt(0)
        val
    }

    peek() {
        (_items size == 0) ifTrue({ raise("Queue is empty") })
        _items at(0)
    }

    isEmpty() {
        _items size == 0
    }

    size() {
        _items size
    }

    toArray() {
        _items
    }

    toString() {
        "Queue" + _items toString()
    }
}

// --- Range: numeric iteration ---
Range = Object clone {
    _start = 0
    _end = 0
    _step = 1

    new(start, end) {
        r = self clone
        r _start = start
        r _end = end
        r _step = 1
        r
    }

    newWithStep(start, end, step) {
        r = self clone
        r _start = start
        r _end = end
        r _step = step
        r
    }

    each(block) {
        i = _start
        step = _step
        end = _end
        { i <= end } whileTrue({
            block value(i)
            i += step
        })
        self
    }

    map(block) {
        result = []
        self each({ |i| result append(block value(i)) })
        result
    }

    filter(block) {
        result = []
        self each({ |i|
            block value(i) ifTrue({
                result append(i)
            })
        })
        result
    }

    toArray() {
        result = []
        self each({ |i| result append(i) })
        result
    }

    contains(n) {
        n >= _start && n <= _end
    }

    size() {
        diff = _end - _start
        (diff < 0) ifTrue({ 0 }) ifFalse({
            diff / _step + 1
        })
    }

    toString() {
        "Range(" + _start toString() + ", " + _end toString() + ", " + _step toString() + ")"
    }
}
