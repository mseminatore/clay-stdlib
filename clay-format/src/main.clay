// clay-format -- String and number formatting utilities for Clay
//
// Usage:
//   import("clay-format")
//
//   Fmt padLeft("hi", 10)        // "        hi"
//   Fmt padRight("hi", 10, ".") // "hi........"
//   Fmt center("hi", 10)        // "    hi    "
//   Fmt repeat("ab", 3)         // "ababab"
//   Fmt capitalize("hello")     // "Hello"
//   Fmt truncate("long string", 6) // "lon..."
//   Fmt join(["a","b","c"], "-")   // "a-b-c"

Fmt = Object clone {
    padLeft(str, width) {
        s = str toString()
        { s length < width } whileTrue({
            s = " " + s
        })
        s
    }

    padLeftWith(str, width, ch) {
        s = str toString()
        { s length < width } whileTrue({
            s = ch + s
        })
        s
    }

    padRight(str, width) {
        s = str toString()
        { s length < width } whileTrue({
            s = s + " "
        })
        s
    }

    padRightWith(str, width, ch) {
        s = str toString()
        { s length < width } whileTrue({
            s = s + ch
        })
        s
    }

    center(str, width) {
        s = str toString()
        toggle = true
        { s length < width } whileTrue({
            (toggle == true) ifTrue({
                s = " " + s
            }) ifFalse({
                s = s + " "
            })
            toggle = (toggle == false)
        })
        s
    }

    repeat(str, n) {
        result = ""
        i = 0
        { i < n } whileTrue({
            result = result + str
            i += 1
        })
        result
    }

    capitalize(str) {
        (str length > 0) ifTrue({
            str at(0) upper + str slice(1, str length)
        }) ifFalse({
            str
        })
    }

    titleCase(str) {
        words = str split(" ")
        result = []
        words each({ |w|
            result append(self capitalize(w))
        })
        result join(" ")
    }

    truncate(str, maxLen) {
        (str length > maxLen) ifTrue({
            str slice(0, maxLen - 3) + "..."
        }) ifFalse({
            str
        })
    }

    join(arr, sep) {
        arr join(sep)
    }

    lines(str) {
        str split("\n")
    }

    chars(str) {
        result = []
        i = 0
        { i < str length } whileTrue({
            result append(str at(i))
            i += 1
        })
        result
    }

    contains(str, sub) {
        str contains(sub)
    }

    replaceAll(str, old, new) {
        result = str
        { result contains(old) } whileTrue({
            result = result replace(old, new)
        })
        result
    }

    wrap(str, width) {
        words = str split(" ")
        lines = []
        current = ""
        words each({ |w|
            test = current
            (current length > 0) ifTrue({
                test = current + " " + w
            }) ifFalse({
                test = w
            })
            (test length > width) ifTrue({
                (current length > 0) ifTrue({
                    lines append(current)
                })
                current = w
            }) ifFalse({
                current = test
            })
        })
        (current length > 0) ifTrue({
            lines append(current)
        })
        lines join("\n")
    }
}
