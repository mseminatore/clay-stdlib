// clay-event -- Event emitter for Clay
//
// Usage:
//   import("clay-event")
//
//   emitter = Emitter new()
//   emitter on("click", { |data| ("clicked: " + data toString()) println() })
//   emitter emit("click", "button1")
//   emitter off("click")

Emitter = Object clone {
    _handlers = nil

    new() {
        e = self clone
        e _handlers = Dict clone
        e
    }

    on(event, handler) {
        key = event toString()
        _handlers has(key) ifFalse({
            _handlers set(key, [])
        })
        _handlers get(key) append(handler)
        self
    }

    off(event) {
        _handlers remove(event toString())
        self
    }

    emit(event) {
        key = event toString()
        _handlers has(key) ifTrue({
            _handlers get(key) each({ |h| h value() })
        })
        self
    }

    emitWith(event, data) {
        key = event toString()
        _handlers has(key) ifTrue({
            _handlers get(key) each({ |h| h value(data) })
        })
        self
    }

    once(event, handler) {
        key = event toString()
        _handlers has(key) ifFalse({
            _handlers set(key, [])
        })
        wrapper = { |data|
            handler value(data)
            self off(event)
        }
        _handlers get(key) append(wrapper)
        self
    }

    removeAll() {
        self _handlers = Dict clone
        self
    }

    listenerCount(event) {
        key = event toString()
        _handlers has(key) ifTrue({
            _handlers get(key) size
        }) ifFalse({ 0 })
    }

    events() {
        _handlers keys
    }
}
