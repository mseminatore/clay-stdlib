// stdlib -- the Clay standard library
//
// import("stdlib") loads every sub-brick; import("stdlib/<name>") loads one.
// Each defines its own globals (Json, Markdown, ArgParser, ...), and no two
// sub-bricks define the same name.

import("stdlib/args")
import("stdlib/base64")
import("stdlib/cache")
import("stdlib/cli")
import("stdlib/collections")
import("stdlib/config")
import("stdlib/csv")
import("stdlib/enum")
import("stdlib/env")
import("stdlib/event")
import("stdlib/format")
import("stdlib/functional")
import("stdlib/http-server")
import("stdlib/iter")
import("stdlib/json")
import("stdlib/log")
import("stdlib/markdown")
import("stdlib/match")
import("stdlib/orm")
import("stdlib/path")
import("stdlib/queue")
import("stdlib/router")
import("stdlib/template")
import("stdlib/test")
import("stdlib/url")
import("stdlib/uuid")
import("stdlib/validate")

// === Assert -- simple assertion helper ===
Assert = Object clone {
    that(cond, msg) {
        (cond == false) ifTrue {
            raise("Assertion failed: " + msg)
        }
        true
    }

    equal(a, b) {
        (a == b) ifFalse {
            raise("Assertion failed: expected " + a toString() + " == " + b toString())
        }
        true
    }

    notEqual(a, b) {
        (a != b) ifFalse {
            raise("Assertion failed: expected " + a toString() + " != " + b toString())
        }
        true
    }

    notNil(val) {
        (val == nil) ifTrue {
            raise("Assertion failed: expected non-nil value")
        }
        true
    }
}

// === Time -- elapsed time measurement ===
Time = Object clone {
    now() { System clock() }

    measure(block) {
        start = System clock()
        r = block value()
        elapsed = System clock() - start
        obj = Object clone {}
        obj _result = r
        obj _elapsed = elapsed
        obj
    }
}

// === MathUtil -- extra math utilities ===
MathUtil = Object clone {
    abs(n) {
        (n < 0) ifTrue { 0 - n } ifFalse { n }
    }

    clamp(n, lo, hi) {
        (n < lo) ifTrue { lo } ifFalse {
            (n > hi) ifTrue { hi } ifFalse { n }
        }
    }

    lerp(a, b, t) {
        a + (b - a) * t
    }

    sign(n) {
        (n > 0) ifTrue { 1 } ifFalse {
            (n < 0) ifTrue { 0 - 1 } ifFalse { 0 }
        }
    }
}
