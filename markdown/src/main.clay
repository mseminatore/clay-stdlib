// stdlib/markdown -- Markdown to HTML converter
//
// Usage:
//   import("stdlib/markdown")
//
//   Markdown render("# Hello\n\nThis is **bold** and *italic*.")
//   // => "<h1 id=\"hello\">Hello</h1>\n<p>This is <strong>bold</strong> and <em>italic</em>.</p>"
//
//   Markdown renderPage(md, "Title")   // a complete UTF-8 HTML document
//
// Text and code are HTML-escaped (& < >); code spans and code blocks are
// taken literally (no emphasis or links inside them).

Markdown = Object clone {
  render(md) {
    lines = md split("\n")
    out = Array new()
    inCodeBlock = false
    inParagraph = false
    codeLines = Array new()
    codeLang = ""
    codeFence = 3
    inTable = false
    tableAligns = Array new()
    inBlockquote = false
    bqLines = Array new()
    // List nesting: listStack tracks open list types at each depth
    listStack = Array new()
    // the open list item: [type, text, number, index in out] (its later
    // lines are appended until the list ends)
    lastItem = nil
    i = 0

    { i < lines size() } whileTrue {
      line = lines at(i)

      inCodeBlock ifTrue {
        // closed by a run of at least as many backticks as opened it
        (line trim() startsWith("`" repeat(codeFence))) ifTrue {
          out push(self _codeBlock(codeLines, codeLang))
          codeLines = Array new()
          inCodeBlock = false
        } ifFalse {
          codeLines push(line)
        }
      } ifFalse {
        trimmed = line trim()

        // Check for fenced code block start
        (trimmed startsWith("```")) ifTrue {
          self _closeParagraph(out, inParagraph) ifTrue { inParagraph = false }
          self _closeAllLists(out, listStack)
          listStack = Array new()
          self _closeTable(out, inTable) ifTrue { inTable = false }
          self _closeBlockquote(out, inBlockquote, bqLines) ifTrue {
            inBlockquote = false
            bqLines = Array new()
          }
          inCodeBlock = true
          codeLines = Array new()
          codeFence = self _backtickRun(trimmed)
          codeLang = self _fenceLanguage(trimmed slice(codeFence, trimmed length))
        } ifFalse {
          // Check for horizontal rule
          isHR = false
          (trimmed == "---") ifTrue { isHR = true }
          (trimmed == "***") ifTrue { isHR = true }
          (trimmed == "___") ifTrue { isHR = true }

          isHR ifTrue {
            self _closeParagraph(out, inParagraph) ifTrue { inParagraph = false }
            self _closeAllLists(out, listStack)
            listStack = Array new()
            self _closeTable(out, inTable) ifTrue { inTable = false }
            self _closeBlockquote(out, inBlockquote, bqLines) ifTrue {
              inBlockquote = false
              bqLines = Array new()
            }
            out push("<hr>")
          } ifFalse {
            // Check for heading
            isHeading = false
            (line startsWith("# ")) ifTrue { isHeading = true }
            (line startsWith("## ")) ifTrue { isHeading = true }
            (line startsWith("### ")) ifTrue { isHeading = true }
            (line startsWith("#### ")) ifTrue { isHeading = true }
            (line startsWith("##### ")) ifTrue { isHeading = true }
            (line startsWith("###### ")) ifTrue { isHeading = true }

            isHeading ifTrue {
              self _closeParagraph(out, inParagraph) ifTrue { inParagraph = false }
              self _closeAllLists(out, listStack)
              listStack = Array new()
              self _closeTable(out, inTable) ifTrue { inTable = false }
              self _closeBlockquote(out, inBlockquote, bqLines) ifTrue {
                inBlockquote = false
                bqLines = Array new()
              }
              level = 0
              (line startsWith("###### ")) ifTrue { level = 6 }
              (line startsWith("##### ")) ifTrue { level = 5 }
              (line startsWith("#### ")) ifTrue { level = 4 }
              (line startsWith("### ")) ifTrue { level = 3 }
              (line startsWith("## ")) ifTrue { level = 2 }
              (line startsWith("# ")) ifTrue { level = 1 }
              raw = line slice(level + 1, line length()) trim
              content = self _inline(raw)
              out push("<h" + level toString + " id=\"" + (self _slug(raw)) + "\">" + content +
                       "</h" + level toString + ">")
            } ifFalse {
              // Check for blockquote
              isBlockquote = false
              (trimmed startsWith("> ")) ifTrue { isBlockquote = true }
              (trimmed == ">") ifTrue { isBlockquote = true }

              isBlockquote ifTrue {
                self _closeParagraph(out, inParagraph) ifTrue { inParagraph = false }
                self _closeAllLists(out, listStack)
                listStack = Array new()
                self _closeTable(out, inTable) ifTrue { inTable = false }
                content = ""
                (trimmed == ">") ifTrue {
                  content = ""
                } ifFalse {
                  content = trimmed slice(2, trimmed length)
                }
                inBlockquote ifFalse {
                  inBlockquote = true
                  bqLines = Array new()
                }
                bqLines push(content)
              } ifFalse {
                // Close blockquote if we were in one
                self _closeBlockquote(out, inBlockquote, bqLines) ifTrue {
                  inBlockquote = false
                  bqLines = Array new()
                }

                // Check for table row
                isTableRow = false
                (trimmed startsWith("|")) ifTrue { isTableRow = true }

                isTableRow ifTrue {
                  self _closeParagraph(out, inParagraph) ifTrue { inParagraph = false }
                  self _closeAllLists(out, listStack)
                  listStack = Array new()

                  inTable ifFalse {
                    // First table row — this is the header
                    // Check if next line is separator
                    nextIdx = i + 1
                    hasSep = false
                    (nextIdx < lines size()) ifTrue {
                      nextLine = lines at(nextIdx) trim
                      (nextLine startsWith("|")) ifTrue {
                        (nextLine contains("---")) ifTrue { hasSep = true }
                      }
                    }

                    hasSep ifTrue {
                      // Parse header cells
                      cells = self _parseTableCells(trimmed)
                      // Parse separator for alignment
                      sepLine = lines at(nextIdx) trim
                      tableAligns = self _parseAligns(sepLine)
                      out push("<table style=\"border-collapse: collapse\">")
                      out push("<thead>")
                      out push(self _tableRow(cells, "th", tableAligns))
                      out push("</thead>")
                      out push("<tbody>")
                      inTable = true
                      i = i + 1 // skip separator line
                    } ifFalse {
                      // No separator — treat as data rows
                      cells = self _parseTableCells(trimmed)
                      tableAligns = Array new()
                      out push("<table style=\"border-collapse: collapse\">")
                      out push("<tbody>")
                      out push(self _tableRow(cells, "td", tableAligns))
                      inTable = true
                    }
                  } ifTrue {
                    // Continuing table — data row
                    cells = self _parseTableCells(trimmed)
                    out push(self _tableRow(cells, "td", tableAligns))
                  }
                } ifFalse {
                  // Close table if we were in one
                  self _closeTable(out, inTable) ifTrue { inTable = false }

                  // Check for list item (with indent support)
                  indent = self _indentLevel(line)
                  stripped = line trim
                  listInfo = self _listItemInfo(stripped)
                  isListItem = listInfo at(0)

                  (isListItem == true) ifTrue {
                    self _closeParagraph(out, inParagraph) ifTrue { inParagraph = false }
                    itemType = listInfo at(1)
                    itemText = listInfo at(2)
                    depth = indent / 2

                    // Close deeper lists if we've dedented
                    { listStack size > (depth + 1) } whileTrue {
                      tag = listStack at(listStack size - 1)
                      (tag == "ul") ifTrue { out push("</ul>") } ifFalse { out push("</ol>") }
                      listStack pop
                    }

                    // Open new list or switch type at current depth
                    (listStack size <= depth) ifTrue {
                      // Need to open lists up to this depth
                      { listStack size <= depth } whileTrue {
                        (itemType == "ul") ifTrue { out push("<ul>") } ifFalse { out push("<ol>") }
                        listStack push(itemType)
                      }
                    } ifFalse {
                      // Check if type matches at current depth
                      curType = listStack at(depth)
                      (curType != itemType) ifTrue {
                        (curType == "ul") ifTrue { out push("</ul>") } ifFalse { out push("</ol>") }
                        listStack pop
                        (itemType == "ul") ifTrue { out push("<ul>") } ifFalse { out push("<ol>") }
                        listStack push(itemType)
                      }
                    }

                    lastItem = [itemType, itemText, listInfo at(3), out size]
                    out push(self _listItem(itemType, itemText, listInfo at(3)))
                  } ifFalse {
                    // Check for blank line
                    (trimmed length == 0) ifTrue {
                      self _closeParagraph(out, inParagraph) ifTrue { inParagraph = false }
                      self _closeAllLists(out, listStack)
                      listStack = Array new()
                    } ifFalse {
                      (listStack size > 0 && lastItem != nil) ifTrue {
                        // a continuation line of the open list item
                        lastItem setAt(1, (lastItem at(1)) + " " + trimmed)
                        out setAt(lastItem at(3), self _listItem(lastItem at(0), lastItem at(1), lastItem at(2)))
                        i = i + 1
                        continue
                      }
                      // Regular text line — paragraph
                      self _closeAllLists(out, listStack)
                      listStack = Array new()
                      inParagraph ifTrue {
                        out push(self _inline(line))
                      } ifFalse {
                        out push("<p>" + self _inline(line))
                        inParagraph = true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }

      i = i + 1
    }

    // Close any open blocks
    inParagraph ifTrue { out push("</p>") }
    self _closeAllLists(out, listStack)
    self _closeTable(out, inTable)
    self _closeBlockquote(out, inBlockquote, bqLines)
    inCodeBlock ifTrue {
      out push(self _codeBlock(codeLines, codeLang))
    }

    out join("\n")
  }

  // --- Close helpers (return true if something was closed) ---

  _closeParagraph(out, flag) {
    flag ifTrue {
      out push("</p>")
      true
    } ifFalse { false }
  }

  _closeAllLists(out, stack) {
    { stack size > 0 } whileTrue {
      tag = stack at(stack size - 1)
      (tag == "ul") ifTrue { out push("</ul>") } ifFalse { out push("</ol>") }
      stack pop
    }
  }

  _closeTable(out, flag) {
    flag ifTrue {
      out push("</tbody>")
      out push("</table>")
      true
    } ifFalse { false }
  }

  _closeBlockquote(out, flag, lines) {
    flag ifTrue {
      // Render blockquote content through render() recursively
      inner = lines join("\n")
      rendered = self _inline(inner)
      out push("<blockquote><p>" + rendered + "</p></blockquote>")
      true
    } ifFalse { false }
  }

  // --- List helpers ---

  _indentLevel(line) {
    count = 0
    idx = 0
    { idx < line length } whileTrue {
      ch = line at(idx)
      (ch == " ") ifTrue {
        count = count + 1
        idx = idx + 1
      } ifFalse {
        idx = line length // break
      }
    }
    count
  }

  _listItemInfo(stripped) {
    // Returns [isListItem, type, content, number]
    (stripped startsWith("- ")) ifTrue {
      [true, "ul", stripped slice(2, stripped length), 0]
    } ifFalse {
      (stripped startsWith("* ")) ifTrue {
        [true, "ul", stripped slice(2, stripped length), 0]
      } ifFalse {
        (stripped startsWith("+ ")) ifTrue {
          [true, "ul", stripped slice(2, stripped length), 0]
        } ifFalse {
          isOL = self _isOrderedList(stripped)
          isOL ifTrue {
            dotPos = stripped indexOf(". ")
            num = stripped slice(0, dotPos) toInt
            [true, "ol", stripped slice(dotPos + 2, stripped length), num]
          } ifFalse {
            [false, "", "", 0]
          }
        }
      }
    }
  }

  _listItem(itemType, text, num) {
    (itemType == "ol") ifTrue {
      "<li value=\"" + num toString + "\">" + self _inline(text) + "</li>"
    } ifFalse {
      "<li>" + self _inline(text) + "</li>"
    }
  }

  // --- Table helpers ---

  _parseTableCells(row) {
    // Split "| col1 | col2 |" into ["col1", "col2"]: a `|` inside a code
    // span or written `\|` doesn't split
    cells = Array new()
    cell = ""
    inCode = false
    idx = 0
    n = row length
    { idx < n } whileTrue {
      ch = row at(idx)
      (ch == "\\" && idx + 1 < n && (row at(idx + 1)) == "|") ifTrue {
        cell = cell + "|"
        idx = idx + 2
      } ifFalse {
        (ch == "`") ifTrue { inCode = inCode not }
        (ch == "|" && inCode not) ifTrue {
          cells push(cell trim)
          cell = ""
        } ifFalse {
          cell = cell + ch
        }
        idx = idx + 1
      }
    }
    (cell trim length > 0) ifTrue { cells push(cell trim) }
    // the empty cell before a leading `|`
    (cells size > 0 && (cells at(0)) length == 0) ifTrue { cells shift }
    cells
  }

  _parseAligns(sepRow) {
    // Parse "| :--- | :---: | ---: |" into alignment array
    aligns = Array new()
    parts = sepRow split("|")
    idx = 0
    { idx < parts size } whileTrue {
      cell = parts at(idx) trim
      (cell length > 0) ifTrue {
        leftColon = cell startsWith(":")
        rightColon = cell endsWith(":")
        (leftColon && rightColon) ifTrue {
          aligns push("center")
        } ifFalse {
          rightColon ifTrue {
            aligns push("right")
          } ifFalse {
            aligns push("left")
          }
        }
      }
      idx = idx + 1
    }
    aligns
  }

  _tableRow(cells, tag, aligns) {
    row = "<tr>"
    idx = 0
    { idx < cells size } whileTrue {
      cell = cells at(idx)
      content = self _inline(cell)
      styles = "border: 1px solid #ddd; padding: 6px 13px"
      (idx < aligns size) ifTrue {
        a = aligns at(idx)
        (a != "left") ifTrue {
          styles = styles + "; text-align: " + a
        }
      }
      row = row + "<" + tag + " style=\"" + styles + "\">" + content + "</" + tag + ">"
      idx = idx + 1
    }
    row = row + "</tr>"
    row
  }

  _isOrderedList(line) {
    (line length < 3) ifTrue { false } ifFalse {
      dotPos = line indexOf(". ")
      (dotPos < 1) ifTrue { false } ifFalse {
        allDigits = true
        j = 0
        { j < dotPos } whileTrue {
          ch = line at(j)
          isDigit = false
          (ch == "0") ifTrue { isDigit = true }
          (ch == "1") ifTrue { isDigit = true }
          (ch == "2") ifTrue { isDigit = true }
          (ch == "3") ifTrue { isDigit = true }
          (ch == "4") ifTrue { isDigit = true }
          (ch == "5") ifTrue { isDigit = true }
          (ch == "6") ifTrue { isDigit = true }
          (ch == "7") ifTrue { isDigit = true }
          (ch == "8") ifTrue { isDigit = true }
          (ch == "9") ifTrue { isDigit = true }
          isDigit ifFalse { allDigits = false }
          j = j + 1
        }
        allDigits
      }
    }
  }

  // Inline markup. Code spans first: their text is escaped and kept out of
  // the other rules (held as placeholders while the rest is processed).
  _inline(s) {
    codes = Array new()
    text = self _extractCode(s, codes)
    result = self _escape(text)
    result = self _replaceImages(result)
    result = self _replaceLinks(result)
    result = self _replacePair(result, "**", "<strong>", "</strong>")
    result = self _replacePair(result, "*", "<em>", "</em>")
    idx = 0
    { idx < codes size } whileTrue {
      result = result replace(self _codeMark(idx), "<code>" + (codes at(idx)) + "</code>")
      idx = idx + 1
    }
    result
  }

  // \x01<n>\x02 stands for code span n while the other rules run
  _codeMark(n) { (String chr(1)) + n toString + (String chr(2)) }

  // Replace each code span (a run of backticks up to the same run) with a
  // placeholder; its escaped content goes into codes
  _extractCode(s, codes) {
    out = ""
    idx = 0
    n = s length
    { idx < n } whileTrue {
      ((s at(idx)) == "`") ifTrue {
        ticks = 0
        { idx + ticks < n && (s at(idx + ticks)) == "`" } whileTrue { ticks = ticks + 1 }
        fence = "`" repeat(ticks)
        rest = s slice(idx + ticks, n)
        close = rest indexOf(fence)
        (close >= 0) ifTrue {
          inner = rest slice(0, close)
          // one space of padding on both sides is dropped (`` `x` ``)
          (inner length >= 2 && (inner startsWith(" ")) && (inner endsWith(" "))) ifTrue {
            inner = inner slice(1, inner length - 1)
          }
          out = out + (self _codeMark(codes size))
          codes push(self _escape(inner))
          idx = idx + ticks + close + ticks
        } ifFalse {
          out = out + fence
          idx = idx + ticks
        }
      } ifFalse {
        out = out + (s at(idx))
        idx = idx + 1
      }
    }
    out
  }

  // & < > as entities
  _escape(s) {
    ((s replace("&", "&amp;")) replace("<", "&lt;")) replace(">", "&gt;")
  }

  _backtickRun(s) {
    n = 0
    { n < s length && (s at(n)) == "`" } whileTrue { n = n + 1 }
    n
  }

  // the info after a fence ("clay norun") -> "clay"
  _fenceLanguage(info0) {
    info = info0 trim
    sp = info indexOf(" ")
    (sp >= 0) ifTrue { info = info slice(0, sp) }
    info
  }

  _codeBlock(codeLines, lang) {
    body = self _escape(codeLines join("\n"))
    (lang length > 0) ifTrue {
      return "<pre><code class=\"language-" + (self _escape(lang)) + "\">" + body + "</code></pre>"
    }
    "<pre><code>" + body + "</code></pre>"
  }

  // GitHub-style heading anchor: "Implicit self in methods" -> "implicit-self-in-methods"
  _slug(text) {
    plain = text replace("`", "")
    plain = plain replace("*", "")
    plain = plain lower
    slug = ""
    idx = 0
    { idx < plain length } whileTrue {
      ch = plain at(idx)
      c = plain byteAt(idx)
      ok = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || ch == "-" || ch == "_" || c >= 128
      ok ifTrue { slug = slug + ch }
      (ch == " ") ifTrue { slug = slug + "-" }
      idx = idx + 1
    }
    slug
  }

  // A complete HTML document (UTF-8) around render(md)
  renderPage(md, title = "") {
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n" +
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" +
    "<title>" + (self _escape(title)) + "</title>\n<style>\n" + pageStyle + "</style>\n</head>\n" +
    "<body>\n" + (self render(md)) + "\n</body>\n</html>\n"
  }

  pageStyle = "body { max-width: 52em; margin: 2em auto; padding: 0 1em; font: 16px/1.55 -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif; color: #1f2328; }\n" +
    "code { font: 0.875em ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background: #eff1f3; padding: 0.15em 0.35em; border-radius: 4px; }\n" +
    "pre { background: #f6f8fa; padding: 1em; overflow-x: auto; border-radius: 6px; line-height: 1.45; }\n" +
    "pre code { background: none; padding: 0; font-size: 0.85em; }\n" +
    "table { border-collapse: collapse; margin: 1em 0; }\n" +
    "blockquote { margin: 0; padding: 0 1em; color: #59636e; border-left: 0.25em solid #d1d9e0; }\n" +
    "h1, h2 { border-bottom: 1px solid #d1d9e0; padding-bottom: 0.3em; }\n" +
    "a { color: #0969da; }\n"

  _replacePair(s, marker, openTag, closeTag) {
    result = s
    mlen = marker length
    pos = result indexOf(marker)
    { pos >= 0 } whileTrue {
      rest = result slice(pos + mlen, result length)
      endPos = rest indexOf(marker)
      (endPos >= 0) ifTrue {
        before = result slice(0, pos)
        inner = rest slice(0, endPos)
        after = rest slice(endPos + mlen, rest length)
        result = before + openTag + inner + closeTag + after
        pos = result indexOf(marker)
      } ifFalse {
        pos = -1
      }
    }
    result
  }

  _replaceLinks(s) {
    result = s
    pos = result indexOf("[")
    { pos >= 0 } whileTrue {
      rest = result slice(pos, result length)
      midPos = rest indexOf("](")
      (midPos >= 0) ifTrue {
        endPos = rest indexOf(")")
        (endPos >= 0 && (endPos > midPos)) ifTrue {
          text = rest slice(1, midPos)
          url = rest slice(midPos + 2, endPos)
          before = result slice(0, pos)
          after = result slice(pos + endPos + 1, result length)
          tag = "<a href=\"" + url + "\">" + text + "</a>"
          result = before + tag + after
          pos = result indexOf("[")
        } ifFalse {
          pos = -1
        }
      } ifFalse {
        pos = -1
      }
    }
    result
  }

  _replaceImages(s) {
    result = s
    pos = result indexOf("![")
    { pos >= 0 } whileTrue {
      rest = result slice(pos, result length)
      midPos = rest indexOf("](")
      (midPos >= 0) ifTrue {
        endPos = rest indexOf(")")
        (endPos >= 0 && (endPos > midPos)) ifTrue {
          alt = rest slice(2, midPos)
          src = rest slice(midPos + 2, endPos)
          before = result slice(0, pos)
          after = result slice(pos + endPos + 1, result length)
          tag = "<img src=\"" + src + "\" alt=\"" + alt + "\">"
          result = before + tag + after
          pos = result indexOf("![")
        } ifFalse {
          pos = -1
        }
      } ifFalse {
        pos = -1
      }
    }
    result
  }
}

