// clay-functional -- Functional programming utilities for Clay
//
// Usage:
//   import("clay-functional")
//
//   doubled = Fn map([1, 2, 3], { |x| x * 2 })       // [2, 4, 6]
//   sum = Fn reduce([1, 2, 3], 0, { |acc, x| acc + x }) // 6
//   evens = Fn filter([1, 2, 3, 4], { |x| x % 2 == 0 }) // [2, 4]
//
//   add = Fn curry({ |a, b| a + b })
//   add5 = add value(5)
//   add5 value(3)  // 8
//
//   5 times({ |i| i println() })

Fn = Object clone {
    // --- Core higher-order functions ---

    map(arr, block) {
        result = []
        arr each({ |x| result append(block value(x)) })
        result
    }

    filter(arr, block) {
        result = []
        arr each({ |x|
            block value(x) ifTrue({ result append(x) })
        })
        result
    }

    reduce(arr, init, block) {
        acc = init
        arr each({ |x| acc = block value(acc, x) })
        acc
    }

    // --- Composition ---

    compose(f, g) {
        { |x| f value(g value(x)) }
    }

    pipe(fns) {
        { |x|
            result = x
            fns each({ |f| result = f value(result) })
            result
        }
    }

    // --- Utilities ---

    identity(x) {
        x
    }

    constant(val) {
        { val }
    }

    tap(val, block) {
        block value(val)
        val
    }

    negate(predicate) {
        { |x| predicate value(x) not }
    }

    // --- List operations ---

    any(arr, block) {
        found = false
        arr each({ |x|
            block value(x) ifTrue({ found = true })
        })
        found
    }

    all(arr, block) {
        result = true
        arr each({ |x|
            block value(x) ifFalse({ result = false })
        })
        result
    }

    none(arr, block) {
        result = true
        arr each({ |x|
            block value(x) ifTrue({ result = false })
        })
        result
    }

    find(arr, block) {
        found = nil
        done = false
        arr each({ |x|
            (done == false) ifTrue({
                block value(x) ifTrue({
                    found = x
                    done = true
                })
            })
        })
        found
    }

    count(arr, block) {
        n = 0
        arr each({ |x|
            block value(x) ifTrue({ n += 1 })
        })
        n
    }

    flatten(arr) {
        result = []
        arr each({ |sub| sub each({ |x| result append(x) }) })
        result
    }

    zip(a, b) {
        result = []
        i = 0
        sz = a size
        (b size < sz) ifTrue({ sz = b size })
        { i < sz } whileTrue({
            result append([a at(i), b at(i)])
            i += 1
        })
        result
    }

    sum(arr) {
        self reduce(arr, 0, { |acc, x| acc + x })
    }

    product(arr) {
        self reduce(arr, 1, { |acc, x| acc * x })
    }
}
