// stdlib/match -- Pattern matching for Clay
//
// Usage:
//   import("stdlib/match")
//
//   Match value(x) when(1, { "one" }) when(2, { "two" }) else({ "other" })
//   Match value(x) whenType("String", { |v| v upper() }) else({ |v| v toString() })
//   Match value(x) whenPred({ |v| v > 10 }, { "big" }) else({ "small" })

Match = Object clone {
    _val = nil
    _matched = false
    _result = nil

    value(v) {
        _m = self clone()
        _m _val = v
        _m _matched = false
        _m _result = nil
        _m
    }

    when(pattern, block) {
        (_matched == false) ifTrue {
            (_val == pattern) ifTrue {
                _matched = true
                _result = block value(_val)
            }
        }
        self
    }

    whenType(typeName, block) {
        (_matched == false) ifTrue {
            (_val type() == typeName) ifTrue {
                _matched = true
                _result = block value(_val)
            }
        }
        self
    }

    whenPred(pred, block) {
        (_matched == false) ifTrue {
            (pred value(_val) == true) ifTrue {
                _matched = true
                _result = block value(_val)
            }
        }
        self
    }

    else(block) {
        (_matched == false) ifTrue {
            _matched = true
            _result = block value(_val)
        }
        _result
    }

    result() {
        _result
    }
}
