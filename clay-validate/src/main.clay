// clay-validate -- Schema validation for Dicts
//
// Usage:
//   import("clay-stdlib/clay-validate")
//
//   schema = Schema new()
//   schema required("title", "string")
//   schema optional("done", "number", 0)
//   schema minLength("title", 1)
//   schema max("done", 1)
//
//   errors = schema validate(data)
//   (errors size() == 0) ifTrue { "valid!" println }

Schema = Object clone {
    new() {
        s = self clone
        s _fields = Array new()
        s
    }

    // Add a required field with type check
    required(name, type) {
        self _fields push(self _makeField(name, type, true, nil))
        self
    }

    // Add an optional field with type check and default value
    optional(name, type, default) {
        self _fields push(self _makeField(name, type, false, default))
        self
    }

    // Add a minimum length constraint (for strings/arrays)
    minLength(name, n) {
        self _addRule(name, "minLength", n)
        self
    }

    // Add a maximum length constraint (for strings/arrays)
    maxLength(name, n) {
        self _addRule(name, "maxLength", n)
        self
    }

    // Add a minimum value constraint (for numbers)
    min(name, n) {
        self _addRule(name, "min", n)
        self
    }

    // Add a maximum value constraint (for numbers)
    max(name, n) {
        self _addRule(name, "max", n)
        self
    }

    // Add a regex pattern constraint (for strings)
    pattern(name, regex) {
        self _addRule(name, "pattern", regex)
        self
    }

    // Add a set of allowed values
    oneOf(name, values) {
        self _addRule(name, "oneOf", values)
        self
    }

    // Add a custom validation rule (block receives value, returns true/false)
    rule(name, fn) {
        self _addRule(name, "custom", fn)
        self
    }

    // Validate a Dict against the schema, returns array of error strings
    validate(data) {
        errors = Array new()

        self _fields each { |field|
            name = field get("name")
            hasKey = data has(name)
            isRequired = field get("required")

            // Check required
            (isRequired && (hasKey == false)) ifTrue {
                errors push(name + " is required")
            }

            // Apply defaults for missing optional fields
            ((isRequired == false) && (hasKey == false)) ifTrue {
                data set(name, field get("default"))
            }

            // Type check and rules (only if field present)
            (hasKey) ifTrue {
                val = data get(name)
                expectedType = field get("type")
                typeOk = true

                // Type check
                (expectedType != nil) ifTrue {
                    actualType = val type()
                    (expectedType == "number") ifTrue {
                        ((actualType != "Number") && (actualType != "Float")) ifTrue {
                            errors push(name + " must be a " + expectedType)
                            typeOk = false
                        }
                    }
                    (expectedType == "string") ifTrue {
                        (actualType != "String") ifTrue {
                            errors push(name + " must be a " + expectedType)
                            typeOk = false
                        }
                    }
                    (expectedType == "array") ifTrue {
                        (actualType != "Array") ifTrue {
                            errors push(name + " must be a " + expectedType)
                            typeOk = false
                        }
                    }
                    (expectedType == "bool") ifTrue {
                        ((val != true) && (val != false)) ifTrue {
                            errors push(name + " must be a " + expectedType)
                            typeOk = false
                        }
                    }
                }

                // Apply rules only if type check passed
                (typeOk) ifTrue {
                    rules = field get("rules")
                    (rules != nil) ifTrue {
                        rules each { |r|
                            ruleType = r get("type")
                            ruleVal = r get("value")

                            (ruleType == "minLength") ifTrue {
                                (val length() < ruleVal) ifTrue {
                                    errors push(name + " must be at least " + ruleVal toString() + " characters")
                                }
                            }
                            (ruleType == "maxLength") ifTrue {
                                (val length() > ruleVal) ifTrue {
                                    errors push(name + " must be at most " + ruleVal toString() + " characters")
                                }
                            }
                            (ruleType == "min") ifTrue {
                                (val < ruleVal) ifTrue {
                                    errors push(name + " must be at least " + ruleVal toString())
                                }
                            }
                            (ruleType == "max") ifTrue {
                                (val > ruleVal) ifTrue {
                                    errors push(name + " must be at most " + ruleVal toString())
                                }
                            }
                            (ruleType == "pattern") ifTrue {
                                (val test(ruleVal) == false) ifTrue {
                                    errors push(name + " does not match pattern " + ruleVal)
                                }
                            }
                            (ruleType == "oneOf") ifTrue {
                                found = false
                                ruleVal each { |allowed|
                                    (val == allowed) ifTrue { found = true }
                                }
                                (found == false) ifTrue {
                                    errors push(name + " must be one of the allowed values")
                                }
                            }
                            (ruleType == "custom") ifTrue {
                                (ruleVal value(val) == false) ifTrue {
                                    errors push(name + " failed custom validation")
                                }
                            }
                        }
                    }
                }
            }
        }

        errors
    }

    // -- Internal helpers --

    _makeField(name, type, isRequired, default) {
        f = #{name: name, type: type, required: isRequired, default: default, rules: Array new()}
        f
    }

    _addRule(name, ruleType, ruleVal) {
        self _fields each { |field|
            (field get("name") == name) ifTrue {
                r = #{type: ruleType, value: ruleVal}
                field get("rules") push(r)
            }
        }
    }
}
