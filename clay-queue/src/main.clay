// clay-queue -- SQLite-backed persistent job queue
//
// Usage:
//   import("clay-queue")
//
//   db = Db open("app.db")
//   queue = JobQueue new(db, "jobs")
//   queue push("email", "user_id=42")
//   job = queue pop()
//   queue complete(job)

JobQueue = Object clone {
  new(db, tableName) {
    q = JobQueue clone
    q _db = db
    q _table = tableName
    db exec("CREATE TABLE IF NOT EXISTS " + tableName + " (id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT, payload TEXT, status TEXT DEFAULT 'pending', created_at TEXT, updated_at TEXT)")
    q
  }

  push(type, payload) {
    now = Date now() toString()
    self _db exec("INSERT INTO " + self _table + " (type, payload, status, created_at, updated_at) VALUES ('" + type + "', '" + payload + "', 'pending', '" + now + "', '" + now + "')")
  }

  pop() {
    rows = self _db query("SELECT id, type, payload, status FROM " + self _table + " WHERE status = 'pending' ORDER BY id ASC LIMIT 1")
    (rows size() == 0) ifTrue { nil } ifFalse {
      row = rows at(0)
      now = Date now() toString()
      self _db exec("UPDATE " + self _table + " SET status = 'processing', updated_at = '" + now + "' WHERE id = " + row get("id") toString())
      row set("status", "processing")
      row
    }
  }

  complete(job) {
    now = Date now() toString()
    self _db exec("UPDATE " + self _table + " SET status = 'done', updated_at = '" + now + "' WHERE id = " + job get("id") toString())
  }

  fail(job, reason) {
    now = Date now() toString()
    self _db exec("UPDATE " + self _table + " SET status = 'failed', payload = '" + reason + "', updated_at = '" + now + "' WHERE id = " + job get("id") toString())
  }

  _count(where) {
    rows = self _db query("SELECT COUNT(*) AS cnt FROM " + self _table + where)
    rows at(0) get("cnt")
  }

  pending()    { self _count(" WHERE status = 'pending'") }
  processing() { self _count(" WHERE status = 'processing'") }
  failed()     { self _count(" WHERE status = 'failed'") }
  size()       { self _count("") }

  retry() {
    now = Date now() toString()
    self _db exec("UPDATE " + self _table + " SET status = 'pending', updated_at = '" + now + "' WHERE status = 'failed'")
  }

  clear() {
    self _db exec("DELETE FROM " + self _table + " WHERE status = 'done'")
  }
}
