// clay-json -- JSON stringify and parse for Clay
//
// Usage:
//   import("clay-json")
//
//   Json stringify(Dict new() set("name", "Clay") set("age", 1))
//   // => {"name":"Clay","age":1}
//
//   Json parse("{\"name\":\"Clay\",\"age\":1}")
//   // => Dict with name="Clay", age=1
//
//   Json prettyPrint(dict)
//   // => formatted with indentation

Json = Object clone {
    _result = "null"
    _src = ""
    _pos = 0
    _len = 0
    _ch = ""
    _done = false

    // --- Stringify ---

    stringify(val) {
        self _encode(val)
    }

    _encode(val) {
        t = val type()
        (t == "Nil") ifTrue { _result = "null" }
        (t == "Number") ifTrue { _result = val toString() }
        (t == "Boolean") ifTrue { _result = val toString() }
        (t == "String") ifTrue { _result = self _encodeString(val) }
        (t == "Array") ifTrue { _result = self _encodeArray(val) }
        (t == "Dict") ifTrue { _result = self _encodeDict(val) }
        _result
    }

    _encodeString(s) {
        escaped = s replace("\\", "\\\\")
        escaped = escaped replace("\"", "\\\"")
        "\"" + escaped + "\""
    }

    _encodeArray(arr) {
        parts = []
        arr each { |item|
            parts append(self _encode(item))
        }
        "[" + parts join(", ") + "]"
    }

    _encodeDict(dict) {
        parts = []
        dict keys() each { |k|
            parts append(self _encodeString(k) + ": " + self _encode(dict get(k)))
        }
        "{" + parts join(", ") + "}"
    }

    // --- Pretty print ---

    prettyPrint(val) {
        self _pretty(val, 0)
    }

    _pretty(val, depth) {
        t = val type()
        _result = self _encode(val)
        (t == "Dict") ifTrue { _result = self _prettyDict(val, depth) }
        (t == "Array") ifTrue { _result = self _prettyArray(val, depth) }
        _result
    }

    _indent(depth) {
        result = ""
        i = 0
        { i < depth } whileTrue {
            result = result + "  "
            i = i + 1
        }
        result
    }

    _prettyDict(dict, depth) {
        keys = dict keys()
        result = "{}"
        (keys size() > 0) ifTrue {
            parts = []
            pad = self _indent(depth + 1)
            keys each { |k|
                parts append(pad + self _encodeString(k) + ": " + self _pretty(dict get(k), depth + 1))
            }
            result = "{\n" + parts join(",\n") + "\n" + self _indent(depth) + "}"
        }
        result
    }

    _prettyArray(arr, depth) {
        result = "[]"
        (arr size() > 0) ifTrue {
            parts = []
            pad = self _indent(depth + 1)
            arr each { |item|
                parts append(pad + self _pretty(item, depth + 1))
            }
            result = "[\n" + parts join(",\n") + "\n" + self _indent(depth) + "]"
        }
        result
    }

    // --- Parse ---

    parse(str) {
        _src = str
        _pos = 0
        _len = str length()
        self _skipWhitespace()
        result = self _parseValue()
        result
    }

    _peek() {
        _ch = ""
        (_pos < _len) ifTrue { _ch = _src at(_pos) }
        _ch
    }

    _advance() {
        _ch = self _peek()
        _pos = _pos + 1
        _ch
    }

    _skipWhitespace() {
        self _skipWs()
    }

    _parseValue() {
        self _skipWs()
        _ch = self _peek()
        _result = nil
        (_ch == "\"") ifTrue { _result = self _parseString() }
        (_ch == "{" && _result == nil) ifTrue { _result = self _parseObject() }
        (_ch == "[" && _result == nil) ifTrue { _result = self _parseArray() }
        (_ch == "t" && _result == nil) ifTrue { _result = self _parseLiteral("true", true) }
        (_ch == "f" && _result == nil) ifTrue { _result = self _parseLiteral("false", false) }
        (_ch == "n" && _result == nil) ifTrue { _result = self _parseLiteral("null", nil) }
        (("0123456789-" contains(_ch)) && _result == nil) ifTrue {
            _result = self _parseNumber()
        }
        _result
    }

    _skipWs() {
        _done = false
        { _done == false && _pos < _len } whileTrue {
            _ch = _src at(_pos)
            (_ch == " " || _ch == "\n" || _ch == "\r" || _ch == "\t") ifTrue {
                _pos = _pos + 1
            }
            (!(_ch == " " || _ch == "\n" || _ch == "\r" || _ch == "\t")) ifTrue {
                _done = true
            }
        }
    }

    _parseString() {
        self _advance()  // skip opening "
        _result = ""
        _done = false
        { _done == false && _pos < _len } whileTrue {
            _ch = self _advance()
            (_ch == "\"") ifTrue { _done = true }
            (_ch != "\"" && _ch == "\\") ifTrue {
                _ch = self _advance()
                (_ch == "n") ifTrue { _ch = "\n" }
                (_ch == "t") ifTrue { _ch = "\t" }
                (_ch == "r") ifTrue { _ch = "\r" }
                _result = _result + _ch
            }
            (_ch != "\"" && _ch != "\\") ifTrue {
                _result = _result + _ch
            }
        }
        _result
    }

    _parseNumber() {
        _start = _pos
        _isFloat = false
        _digits = "0123456789"
        (self _peek() == "-") ifTrue { _pos = _pos + 1 }
        _done = false
        { _done == false && _pos < _len } whileTrue {
            _ch = _src at(_pos)
            (_digits contains(_ch)) ifTrue { _pos = _pos + 1 }
            (!(_digits contains(_ch)) && _ch == "." && _isFloat == false) ifTrue {
                _isFloat = true
                _pos = _pos + 1
            }
            (!(_digits contains(_ch)) && _ch != ".") ifTrue {
                _done = true
            }
            (!(_digits contains(_ch)) && _ch == "." && _isFloat == true) ifTrue {
                _done = true
            }
        }
        _numStr = _src slice(_start, _pos)
        _result = _numStr toInt()
        (_isFloat == true) ifTrue { _result = _numStr toFloat() }
        _result
    }

    _parseArray() {
        self _advance()  // skip [
        self _fillArray([])
    }

    _fillArray(arr) {
        self _skipWs()
        (self _peek() != "]") ifTrue {
            arr append(self _parseValue())
            self _skipWs()
            { self _peek() == "," } whileTrue {
                self _advance()  // skip ,
                arr append(self _parseValue())
                self _skipWs()
            }
        }
        self _advance()  // skip ]
        arr
    }

    _parseObject() {
        self _advance()  // skip {
        self _fillObject(Dict new())
    }

    _fillObject(dict) {
        self _skipWs()
        (self _peek() != "}") ifTrue {
            self _addKV(dict)
            self _skipWs()
            { self _peek() == "," } whileTrue {
                self _advance()  // skip ,
                self _addKV(dict)
                self _skipWs()
            }
        }
        self _advance()  // skip }
        dict
    }

    _addKV(dict) {
        self _skipWs()
        self _setKV(dict, self _parseString())
    }

    _setKV(dict, key) {
        self _skipWs()
        self _advance()  // skip :
        dict set(key, self _parseValue())
    }

    _parseLiteral(expected, value) {
        _pos = _pos + expected length()
        value
    }
}
