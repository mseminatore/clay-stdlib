// stdlib/url -- URL parsing, building, and encoding
//
// Usage:
//   import("stdlib/url")
//
//   parts = Url parse("https://example.com:8080/path?key=val#frag")
//   parts get("protocol")  // "https"
//   parts get("host")      // "example.com"
//   parts get("port")      // "8080"
//   parts get("path")      // "/path"
//   parts get("query")     // "key=val"
//   parts get("fragment")  // "frag"
//
//   Url build(parts)       // "https://example.com:8080/path?key=val#frag"
//   Url parseQuery("a=1&b=2")  // Dict { "a": "1", "b": "2" }
//   Url encodeComponent("hello world")  // "hello%20world"
//   Url decodeComponent("hello%20world")  // "hello world"

Url = Object clone {
    _hexChars = "0123456789ABCDEF"

    // Is a byte unreserved (RFC 3986): A-Z, a-z, 0-9, "-", ".", "_", "~"
    _isUnreserved(b) {
        ((b >= 65) && (b <= 90)) || ((b >= 97) && (b <= 122)) || ((b >= 48) && (b <= 57)) ||
            (b == 45) || (b == 46) || (b == 95) || (b == 126)
    }

    // Percent-encode a component: every byte but the unreserved ones, so
    // UTF-8 text becomes one %XX per byte ("é" -> "%C3%A9")
    encodeComponent(str) {
        hex = _hexChars bytes
        out = []
        str toString bytes each { |b|
            (_isUnreserved(b)) ifTrue { out push(b) } ifFalse {
                out push(37)   // "%"
                out push(hex at(b >> 4))
                out push(hex at(b & 15))
            }
        }
        String fromBytes(out)
    }

    // Decode a percent-encoded component ("+" is a space). A "%" not followed
    // by two hex digits is kept as it is.
    decodeComponent(str) {
        b = str toString bytes
        n = b size
        out = []
        i = 0
        { i < n } whileTrue {
            c = b at(i)
            escaped = (c == 37) && (i + 2 < n)
            escaped ifTrue { escaped = ((_hexVal(b at(i + 1))) >= 0) && ((_hexVal(b at(i + 2))) >= 0) }
            escaped ifTrue {
                hi = _hexVal(b at(i + 1))
                lo = _hexVal(b at(i + 2))
                out push(hi * 16 + lo)
                i = i + 3
            } ifFalse {
                out push((c == 43) ifTrue { 32 } ifFalse { c })
                i = i + 1
            }
        }
        String fromBytes(out)
    }

    // A hex digit byte's value, or -1
    _hexVal(c) {
        ((c >= 48) && (c <= 57)) ifTrue { return c - 48 }
        ((c >= 65) && (c <= 70)) ifTrue { return c - 55 }
        ((c >= 97) && (c <= 102)) ifTrue { return c - 87 }
        -1
    }

    // Parse a URL string into a Dict
    parse(url) {
        result = Dict new()
        rest = url

        // Protocol
        protoIdx = rest indexOf("://")
        (protoIdx != -1 && protoIdx > 0) ifTrue {
            result set("protocol", rest slice(0, protoIdx))
            rest = rest slice(protoIdx + 3, rest length())
        } ifFalse {
            result set("protocol", "")
        }

        // Fragment
        fragIdx = rest indexOf("#")
        (fragIdx != -1) ifTrue {
            result set("fragment", rest slice(fragIdx + 1, rest length()))
            rest = rest slice(0, fragIdx)
        } ifFalse {
            result set("fragment", "")
        }

        // Query
        qIdx = rest indexOf("?")
        (qIdx != -1) ifTrue {
            result set("query", rest slice(qIdx + 1, rest length()))
            rest = rest slice(0, qIdx)
        } ifFalse {
            result set("query", "")
        }

        // Path
        pathIdx = rest indexOf("/")
        (pathIdx != -1) ifTrue {
            result set("path", rest slice(pathIdx, rest length()))
            rest = rest slice(0, pathIdx)
        } ifFalse {
            result set("path", "")
        }

        // Host and port
        portIdx = rest indexOf(":")
        (portIdx != -1) ifTrue {
            result set("host", rest slice(0, portIdx))
            result set("port", rest slice(portIdx + 1, rest length()))
        } ifFalse {
            result set("host", rest)
            result set("port", "")
        }

        result
    }

    // Build URL string from parts Dict
    build(parts) {
        result = ""
        proto = parts get("protocol")
        (proto != nil && proto != "") ifTrue {
            result = result + proto + "://"
        }
        result = result + parts get("host")
        port = parts get("port")
        (port != nil && port != "") ifTrue {
            result = result + ":" + port
        }
        result = result + parts get("path")
        query = parts get("query")
        (query != nil && query != "") ifTrue {
            result = result + "?" + query
        }
        frag = parts get("fragment")
        (frag != nil && frag != "") ifTrue {
            result = result + "#" + frag
        }
        result
    }

    // Parse query string "a=1&b=2" into Dict
    parseQuery(qs) {
        result = Dict new()
        pairs = qs split("&")
        pairs each { |pair|
            eqIdx = pair indexOf("=")
            (eqIdx != -1) ifTrue {
                key = decodeComponent(pair slice(0, eqIdx))
                val = decodeComponent(pair slice(eqIdx + 1, pair length()))
                result set(key, val)
            } ifFalse {
                (pair length() > 0) ifTrue {
                    result set(decodeComponent(pair), "")
                }
            }
        }
        result
    }
}
