// stdlib/csv -- CSV parsing and generation for Clay
//
// Usage:
//   import("stdlib/csv")
//
//   Csv parse("a,b,c\n1,2,3")
//   // => [[a, b, c], [1, 2, 3]]
//
//   Csv parseWithHeader("name,age\nClay,1\nFoo,2")
//   // => [Dict{name:Clay, age:1}, Dict{name:Foo, age:2}]
//
//   Csv stringify([[1, 2], [3, 4]])
//   // => "1,2\n3,4"

Csv = Object clone {
    _src = ""
    _pos = 0
    _len = 0
    _ch = ""
    _done = false
    _rowDone = false
    _result = ""
    _isQuoted = false

    parse(str) {
        _src = str
        _pos = 0
        _len = str length()
        self _parseRows([])
    }

    _parseRows(rows) {
        { _pos < _len } whileTrue {
            rows append(self _parseRow([]))
        }
        rows
    }

    _parseRow(fields) {
        { true } whileTrue {
            fields append(self _parseField())
            (_pos < _len) ifTrue {
                _ch = _src at(_pos)
                (_ch == ",") ifTrue {
                    _pos = _pos + 1
                }
                (_ch == "\n") ifTrue {
                    _pos = _pos + 1
                    break
                }
                (_ch != "," && _ch != "\n") ifTrue {
                    break
                }
            }
            (_pos >= _len) ifTrue { break }
        }
        fields
    }

    _parseField() {
        _isQuoted = false
        (_pos < _len && _src at(_pos) == "\"") ifTrue {
            _isQuoted = true
        }
        _result = ""
        (_isQuoted == true) ifTrue { _result = self _parseQuoted() }
        (_isQuoted == false) ifTrue { _result = self _parseUnquoted() }
        _result
    }

    _parseUnquoted() {
        _result = ""
        { _pos < _len } whileTrue {
            _ch = _src at(_pos)
            (_ch == "," || _ch == "\n") ifTrue { break }
            _result = _result + _ch
            _pos = _pos + 1
        }
        _result
    }

    _parseQuoted() {
        _pos = _pos + 1  // skip opening "
        _result = ""
        { _pos < _len } whileTrue {
            _ch = _src at(_pos)
            _pos = _pos + 1
            (_ch == "\"") ifTrue {
                // Check for escaped quote ""
                (_pos < _len && _src at(_pos) == "\"") ifTrue {
                    _result = _result + "\""
                    _pos = _pos + 1
                }
                (_pos >= _len || !(_src at(_pos) == "\"")) ifTrue {
                    break
                }
            }
            (_ch != "\"") ifTrue {
                _result = _result + _ch
            }
        }
        _result
    }

    parseWithHeader(str) {
        self _parseWithHdr(self parse(str))
    }

    _parseWithHdr(rows) {
        (rows size() == 0) ifTrue { [] }
        self _mapRows(rows at(0), rows, 1, [])
    }

    _mapRows(headers, rows, idx, result) {
        { idx < rows size() } whileTrue {
            self _makeDict(headers, rows at(idx), result)
            idx = idx + 1
        }
        result
    }

    _makeDict(headers, row, result) {
        _d = Dict new()
        _i = 0
        { _i < headers size() && _i < row size() } whileTrue {
            _d set(headers at(_i), row at(_i))
            _i = _i + 1
        }
        result append(_d)
    }

    stringify(rows) {
        self _stringifyRows(rows, [], 0)
    }

    _stringifyRows(rows, parts, idx) {
        { idx < rows size() } whileTrue {
            self _stringifyRow(rows at(idx), parts)
            idx = idx + 1
        }
        parts join("\n")
    }

    _stringifyRow(row, parts) {
        _cols = []
        row each { |field|
            _cols append(self _encodeField(field))
        }
        parts append(_cols join(","))
    }

    _encodeField(val) {
        _s = val toString()
        (_s contains(",") || _s contains("\"") || _s contains("\n")) ifTrue {
            _s = "\"" + _s replace("\"", "\"\"") + "\""
        }
        _s
    }
}
